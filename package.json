{
  "name": "@tawaship/pixim-animate-runtime",
  "version": "0.1.0",
  "description": "Plays Adobe Animate HTML5 Canvas content in Pixim.js: loads runtime content generated by @tawaship/pixi-animate-runtime as a Pixim content asset.",
  "main": "dist/pixim-animate-runtime.cjs.js",
  "module": "dist/pixim-animate-runtime.esm.js",
  "browser": "dist/pixim-animate-runtime.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "rollup": "rollup -c --bundleConfigAsCjs",
    "d": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir ./types",
    "build": "npm run rollup -- --environment PROD && npm run d && echo done.",
    "docs": "typedoc"
  },
  "keywords": [
    "pixi.js",
    "pixim.js",
    "adobe-animate",
    "createjs"
  ],
  "author": "tawaship",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tawaship/Pixim-animate-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/tawaship/Pixim-animate-runtime/issues"
  },
  "homepage": "https://tawaship.github.io/Pixim-animate-runtime/",
  "peerDependencies": {
    "@tawaship/pixim.js": "^1.15.2",
    "pixi.js": "^5.3.2"
  },
  "dependencies": {
    "@tawaship/pixi-animate-runtime": "^0.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tawaship/pixim.js": "1.15.2",
    "del": "^8.0.1",
    "pixi.js": "5.3.9",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  }
}
